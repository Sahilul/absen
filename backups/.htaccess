# v1.24.0 - Proteksi folder backup (defense-in-depth)
# Blokir semua akses web ke folder backup.
# Catatan: pada server nginx, proteksi utama sudah ditangani konfigurasi server (401).
# File ini sebagai lapisan tambahan jika folder ini dipindah ke server Apache.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Matikan listing direktori
Options -Indexes
